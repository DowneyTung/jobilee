{
  "name": "jobilee",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test --filter='./packages/*' --filter='./services/*'",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "test:integration": "pnpm --filter @jobilee/integration-tests test",
    "test:e2e": "pnpm --filter @jobilee/e2e-tests test"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^7.0.2"
  }
}
