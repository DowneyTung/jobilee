{
  "name": "@jobilee/service-kit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test \"dist-test/**/*.test.js\"",
    "clean": "rm -rf dist dist-test .turbo"
  },
  "dependencies": {
    "@jobilee/logger": "workspace:*",
    "@jobilee/shared-types": "workspace:*"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@nestjs/common": "^11.0.7",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typescript": "^7.0.2",
    "zod": "^3.24.1"
  }
}
