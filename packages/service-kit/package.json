{
  "name": "@jobilee/service-kit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test dist/*.test.js",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@jobilee/logger": "workspace:*",
    "@jobilee/shared-types": "workspace:*"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@nestjs/common": "^11.0.7",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typescript": "^5.7.3",
    "zod": "^3.24.1"
  }
}
