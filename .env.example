# Copy to .env and fill in secrets:  cp .env.example .env
# .env is gitignored — never commit real credentials.

# --- shared ---
NODE_ENV=development
LOG_LEVEL=debug
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# --- postgres (one instance, one DB per service) ---
POSTGRES_USER=jobilee
POSTGRES_PASSWORD=jobilee
POSTGRES_DB=jobilee
POSTGRES_PORT=5432
AUTH_DATABASE_URL=postgresql://jobilee:jobilee@postgres:5432/auth
JOBS_DATABASE_URL=postgresql://jobilee:jobilee@postgres:5432/jobs
RESUME_DATABASE_URL=postgresql://jobilee:jobilee@postgres:5432/resume
AI_DATABASE_URL=postgresql://jobilee:jobilee@postgres:5432/ai

# --- redis ---
REDIS_URL=redis://redis:6379
REDIS_PORT=6379

# --- object storage (MinIO) ---
S3_ENDPOINT=http://minio:9000
# Where the BROWSER reaches MinIO; presigned URLs are signed for this host.
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=resumes
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- ai-service (ONLY place the key lives) ---
ANTHROPIC_API_KEY=sk-ant-...
# Model ids rotate — check https://docs.claude.com/en/docs/about-claude/models/overview
AI_MODEL_GENERATION=claude-sonnet-5
AI_MODEL_CHEAP=claude-haiku-4-5
AI_WORKER_CONCURRENCY=2
AI_DAILY_TASK_CAP=50

# --- service discovery (compose DNS names) ---
AUTH_SERVICE_URL=http://auth-service:3001
JOBS_SERVICE_URL=http://jobs-service:3002
RESUME_SERVICE_URL=http://resume-service:3003
AI_SERVICE_URL=http://ai-service:3004

# --- host-published ports ---
# --- gateway rate limiting ---
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=20

# --- host-published ports ---
GATEWAY_PORT=8080
WEB_ORIGIN=http://localhost:5173
WEB_PORT=5173
VITE_API_BASE=http://localhost:8080/api
