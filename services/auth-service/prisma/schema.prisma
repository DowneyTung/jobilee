// auth-service owns exactly one table. No other service reads it — they know
// users only by the uuid the gateway forwards as X-User-Id.

generator client {
  provider = "prisma-client-js"
  // Each service generates its own client. With the default output they would
  // all write to the one hoisted node_modules/@prisma/client and clobber each
  // other — the last `prisma generate` in the workspace would win.
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("AUTH_DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  @@map("users")
}
